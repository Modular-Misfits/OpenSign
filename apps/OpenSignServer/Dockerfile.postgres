FROM node:22-bookworm-slim

ENV NODE_ENV=production \
    PNPM_HOME=/pnpm \
    PATH=/pnpm:$PATH

RUN corepack enable \
    && apt-get update \
    && apt-get install -y --no-install-recommends ca-certificates openssl fonts-liberation \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml ./
RUN --mount=type=cache,id=opensign-server-pnpm,target=/pnpm/store \
    pnpm install --prod --frozen-lockfile

COPY --chown=node:node . .
RUN install -d -o node -g node /app/files /app/exports

USER node
EXPOSE 8080
CMD ["node", "index.js"]
