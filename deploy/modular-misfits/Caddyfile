{
	admin off
	auto_https off
}

:3001 {
	encode zstd gzip

	@api path /api/*
	handle @api {
		uri strip_prefix /api
		reverse_proxy server:8080
	}

	handle {
		reverse_proxy client:3000
	}

	header {
		-Server
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
		Permissions-Policy "camera=(), geolocation=(), microphone=()"
	}
}
